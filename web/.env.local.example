# Agnes Creator Studio 环境变量配置
# 复制此文件为 .env.local 并填入你的 API Key

# Agnes AI API Key（从 https://agnes-ai.com 获取）
AGNES_API_KEY=your_api_key_here

# API Base URL（一般不需要修改）
AGNES_BASE_URL=https://apihub.agnes-ai.com

# ---- 可选：分布式限流（Upstash Redis）----
# 不配置时会自动回退为单实例内存限流。
# 部署到 Serverless / 多实例环境时，强烈建议配置这两项，
# 否则每个实例各自计数，限流会被绕过。
# 从 https://console.upstash.com 创建 Redis 后获取
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# 开发服务器端口
PORT=3017

# ---- 公众号登录：共用烟火食间现有认证数据库和验证码服务 ----
# 保留现有公众号回调地址，不指向图片站。详细配置见 ../docs/wechat-login.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WECHAT_LOGIN_HMAC_SECRET=
WECHAT_PUBLIC_ACCOUNT_NAME=与 IT 有约
WECHAT_PUBLIC_ACCOUNT_QR_URL=/wechat-official-account-qr.png
WECHAT_LOGIN_KEYWORD=登录
AUTH_SESSION_MAX_AGE_SECONDS=604800

# 北京时间每日提交额度；0 表示关闭该种能力
IMAGE_DAILY_LIMIT=20
IMAGE_GLOBAL_DAILY_LIMIT=500
VIDEO_DAILY_LIMIT=3
VIDEO_GLOBAL_DAILY_LIMIT=30
CHAT_DAILY_LIMIT=50
CHAT_GLOBAL_DAILY_LIMIT=1000
